# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TENOR_API_KEY: Required for server-side GIF search. Keep this secret on the server; do not prefix with VITE_.
TENOR_API_KEY="MY_TENOR_API_KEY"

# API keys and variables for Stripe backend payment integration.
# STRIPE_SECRET_KEY must stay server-only; VITE_STRIPE_PUBLIC_KEY is safe for the browser.
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
VITE_STRIPE_PUBLIC_KEY="MY_STRIPE_PUBLIC_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# Public base URL for the deployed API server used by the iOS Capacitor app.
# Example: VITE_API_BASE_URL=https://memeforge.example.com
VITE_API_BASE_URL=

# Comma-separated browser/native origins allowed to call the API and Socket.IO.
# Include deployed web origins here; native Capacitor origins are allowed by default.
ALLOWED_ORIGINS=

# Optional comma-separated Capacitor/native origins if you change the iOS scheme/host.
# Defaults include capacitor://localhost and memeforge://localhost.
NATIVE_APP_ORIGINS=
