# Server-only provider secrets
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
TENOR_API_KEY=
TENOR_COUNTRY=US
TENOR_LOCALE=en_US

# Stripe subscription billing (server only)
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin / Application Default Credentials (server only)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=

# Public Firebase web configuration (safe to embed in web/native bundles)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Deployed application/API origins
APP_URL=http://localhost:3000
VITE_API_BASE_URL=
ALLOWED_ORIGINS=
NATIVE_APP_ORIGINS=capacitor://localhost,memeforge://localhost

# Native build and anonymous performance sampling
VITE_IOS_APP=false
VITE_TELEMETRY_SAMPLE_RATE=0.1

# Search/provider resource bounds
SEARCH_CACHE_TTL_MS=3600000
SEARCH_CACHE_MAX_ENTRIES=100
TENOR_MAX_CONCURRENCY=6
TENOR_MAX_QUEUE=12

# Paid AI budgets and bounded work queues
AI_DAILY_REQUEST_LIMIT=25
AI_MAX_ACTIVE_PER_USER=2
AI_MAX_CONCURRENCY=3
AI_MAX_QUEUE=6
# Development only; never enable in production.
ALLOW_FREE_AI=false

# Realtime topology: use single with INSTANCE_COUNT=1, or redis with REDIS_URL.
COLLABORATION_MODE=single
INSTANCE_COUNT=1
REDIS_URL=
MAX_COLLABORATION_ROOMS=500
MAX_COLLABORATORS_PER_ROOM=25
MAX_CANVAS_OBJECTS=250
MAX_CANVAS_PAYLOAD_BYTES=262144
