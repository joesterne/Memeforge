{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint:rules": "eslint firestore.rules storage.rules",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts",
    "test:rules:run": "node --import tsx --test tests/rules/**/*.test.ts",
    "test:rules": "npx --yes firebase-tools@15.25.1 emulators:exec --project demo-memeforge --only firestore,storage \"npm run test:rules:run\"",
    "test": "npm run test:unit && npm run test:rules",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "npm run test && npm run lint:strict && npm run lint:rules && npm run build && npm run check:bundle",
    "build:ios": "VITE_IOS_APP=true vite build",
    "ios:sync": "npm run build:ios && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "migrate:data-urls": "node --import tsx scripts/migrate-data-urls.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "browser-image-compression": "^2.0.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.2.0",
    "konva": "^10.3.0",
    "lucide-react": "^0.546.0",
    "modern-gif": "^2.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-draggable": "^4.7.0",
    "react-konva": "^19.2.4",
    "react-router": "^8.3.0",
    "redis": "^5.8.2",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "use-image": "^1.1.4",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.12",
    "eslint": "^10.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "body-parser": "^2.2.1",
    "postcss": "^8.5.25",
    "uuid": "^11.1.1"
  }
}
