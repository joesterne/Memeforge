rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{category}/{fileName} {
      function validCategory() {
        return category in ['backgrounds', 'elements', 'templates', 'submissions', 'ai'];
      }
      function validImage() {
        return request.resource.size <= 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      }
      allow read: if validCategory() && (
        category in ['templates', 'submissions'] ||
        (request.auth != null && request.auth.uid == uid)
      );
      allow create, update: if validCategory() && request.auth != null && request.auth.uid == uid && validImage();
      allow delete: if validCategory() && request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
