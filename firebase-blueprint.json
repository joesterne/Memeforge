{
  "entities": {
    "CanvasObject": {
      "title": "CanvasObject",
      "description": "Object on the meme canvas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "text": { "type": "string" },
        "url": { "type": "string" },
        "storagePath": { "type": "string" },
        "fontSize": { "type": "number" },
        "fontFamily": { "type": "string" },
        "fill": { "type": "string" },
        "draggable": { "type": "boolean" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "rotation": { "type": "number" }
      },
      "required": ["id", "type", "x", "y"]
    },
    "Meme": {
      "title": "Meme",
      "description": "A customized meme",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "createdAt": { "type": "string" },
        "templateUrl": { "type": ["string", "null"] },
        "templatePath": { "type": ["string", "null"] },
        "objects": { "type": "array", "items": { "$ref": "#/entities/CanvasObject" } }
      },
      "required": ["authorId", "createdAt", "objects"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A favorited meme template",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "templateId": { "type": "string" },
        "url": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "templateId", "url", "name", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A submitted meme",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "memeUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "memeUrl", "storagePath", "createdAt"]
    },
    "Template": {
      "title": "Template",
      "description": "A custom user template",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "url": { "type": "string" },
        "storagePath": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "box_count": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userName", "url", "name", "width", "height", "box_count", "createdAt"]
    },
    "TemplateVote": {
      "title": "TemplateVote",
      "description": "Upvotes and downvotes for a template",
      "type": "object",
      "properties": {
        "upvotes": { "type": "number" },
        "downvotes": { "type": "number" }
      },
      "required": ["upvotes", "downvotes"]
    },
    "UserTemplateVote": {
      "title": "UserTemplateVote",
      "description": "Private vote state for one user and template",
      "type": "object",
      "properties": {
        "value": { "type": "string", "enum": ["up", "down"] }
      },
      "required": ["value"]
    }
  },
  "firestore": {
    "/memes/{memeId}": {
      "schema": "#/entities/Meme",
      "description": "User created memes"
    },
    "/favorites/{favoriteId}": {
      "schema": "#/entities/Favorite",
      "description": "User favorited templates"
    },
    "/submissions/{submissionId}": {
      "schema": "#/entities/Submission",
      "description": "User submitted memes"
    },
    "/templates/{templateId}": {
      "schema": "#/entities/Template",
      "description": "Custom templates"
    },
    "/templateVotes/{templateId}": {
      "schema": "#/entities/TemplateVote",
      "description": "Public aggregate vote counts"
    },
    "/templateVotes/{templateId}/users/{uid}": {
      "schema": "#/entities/UserTemplateVote",
      "description": "Private per-user vote state"
    }
  }
}
